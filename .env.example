# Copy to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase keys empty to run in demo mode (data stays in this browser only).

# The one Supabase account the lock screen signs in as; its password is typed on the lock screen, never stored here.
# Create it in Supabase → Authentication → Users. The same email is in supabase/migrations/*_trip_account.sql.
VITE_APP_EMAIL=

# Supabase → Project Settings → API. The key is the "publishable" key (or the legacy "anon" key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Bills → Scan (server only — no VITE_ prefix, never bundled). From console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Optional: most receipt scans per day (Tokyo time) before /api/scan refuses. Default 30.
SCAN_DAILY_LIMIT=
# Optional: which Claude model reads receipts. Default claude-haiku-5-5 (cheapest); claude-opus-5-5 is the most accurate.
SCAN_MODEL=

# Eats → Map draws a Google map and finds places by name with it. This key is bundled into the page, so in
# Google Cloud restrict it to Maps JavaScript API + Places API (New), and to this site's addresses
# (your Vercel domain and http://localhost:5173/*).
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional: a Map ID from Google Cloud → Google Maps Platform → Map management (JavaScript, Vector).
# Without it the map uses Google's DEMO_MAP_ID, which is meant for testing.
VITE_GOOGLE_MAP_ID=
