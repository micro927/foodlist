# Copy to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase keys empty to run in demo mode (data stays in this browser only).

# Password for the lock screen. Note: bundled into the client JS, so it keeps casual visitors out, not attackers.
VITE_APP_PASSWORD=

# Supabase → Project Settings → API. The key is the "publishable" key (or the legacy "anon" key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Bills → Scan (server only — no VITE_ prefix, never bundled). From console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Optional: most receipt scans per day (Tokyo time) before /api/scan refuses. Default 30.
SCAN_DAILY_LIMIT=
# Optional: which Claude model reads receipts. Default claude-haiku-5-5 (cheapest); claude-opus-5-5 is the most accurate.
SCAN_MODEL=
